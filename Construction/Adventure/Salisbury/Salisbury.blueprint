ckname == \"range4\"\nthen\nrangeindex4 = i\nend\n\nif blockname == \"range5\"\nthen\nrangeindex5 = i\nend\n\nend\n\ntotaltargets = I:GetNumberOfTargets(0)\n\nif totaltargets == 0 \nthen\nI:Component_SetFloatLogic_1(33, index1, 2, 0)\nI:Component_SetFloatLogic_1(33, index2, 2, 0)\nI:Component_SetFloatLogic_1(33, index3, 2, 0)\nI:Component_SetFloatLogic_1(33, index4, 2, 0)\nI:Component_SetFloatLogic_1(33, index5, 2, 0)\nend\n\nif totaltargets == 1 \nthen\nI:Component_SetFloatLogic_1(33, index1, 2, 0.505)\nI:Component_SetFloatLogic_1(33, index2, 2, 0)\nI:Component_SetFloatLogic_1(33, index3, 2, 0)\nI:Component_SetFloatLogic_1(33, index4, 2, 0)\nI:Component_SetFloatLogic_1(33, index5, 2, 0)\nend\nif totaltargets == 2\nthen\nI:Component_SetFloatLogic_1(33, index1, 2, 0.505)\nI:Component_SetFloatLogic_1(33, index2, 2, 0.504)\nI:Component_SetFloatLogic_1(33, index3, 2, 0)\nI:Component_SetFloatLogic_1(33, index4, 2, 0)\nI:Component_SetFloatLogic_1(33, index5, 2, 0)\nend\nif totaltargets == 3\nthen\nI:Component_SetFloatLogic_1(33, index3, 2, 0.503)\nI:Component_SetFloatLogic_1(33, index2, 2, 0.504)\nI:Component_SetFloatLogic_1(33, index1, 2, 0.505)\nI:Component_SetFloatLogic_1(33, index4, 2, 0)\nI:Component_SetFloatLogic_1(33, index5, 2, 0)\nend\nif totaltargets == 4\nthen\nI:Component_SetFloatLogic_1(33, index4, 2, 0.502)\nI:Component_SetFloatLogic_1(33, index3, 2, 0.503)\nI:Component_SetFloatLogic_1(33, index2, 2, 0.504)\nI:Component_SetFloatLogic_1(33, index1, 2, 0.505)\nI:Component_SetFloatLogic_1(33, index5, 2, 0)\nend\nif totaltargets == 5\nthen\nI:Component_SetFloatLogic_1(33, index5, 2, 0.501)\nI:Component_SetFloatLogic_1(33, index4, 2, 0.502)\nI:Component_SetFloatLogic_1(33, index3, 2, 0.503)\nI:Component_SetFloatLogic_1(33, index2, 2, 0.504)\nI:Component_SetFloatLogic_1(33, index1, 2, 0.505)\nend\n\ntarget1 = I:GetTargetPositionInfo(0, 0)\nposition1 = target1.Direction\nrange1 = target1.Range\nazimuth1deg = 90-target1.Azimuth\nazimuth1 = azimuth1deg*Mathf.Deg2Rad  \nxshift1 = (range1*Mathf.Cos(azimuth1))/3000\nyshift1 = (range1*Mathf.Sin(azimuth1))/3000\nI:Component_SetFloatLogic_1(33, index1, 3, -xshift1)\nI:Component_SetFloatLogic_1(33, index1, 4, yshift1)\n\ntarget2 = I:GetTargetPositionInfo(0, 1)\naltitude2 = target2.AltitudeAboveSeaLevel\nrange2 = (target2.Range)/500\nI:Component_SetFloatLogic_1(33, rangeindex2, 2, range2)\nif altitude2>20\nthen\nI:Component_SetFloatLogic_1(33, heightindex2, 2, 1)\nelse\nI:Component_SetFloatLogic_1(33, heightindex2, 2, 0)\nend\nposition2 = target2.Direction\nrange2 = target2.Range\nazimuth2deg = 90-target2.Azimuth\nazimuth2 = azimuth2deg*Mathf.Deg2Rad  \nxshift2 = (range2*Mathf.Cos(azimuth2))/3000\nyshift2 = (range2*Mathf.Sin(azimuth2))/3000\nI:Component_SetFloatLogic_1(33, index2, 3, -xshift2-1)\nI:Component_SetFloatLogic_1(33, index2, 4, yshift2)\n\ntarget3 = I:GetTargetPositionInfo(0, 2)\naltitude3 = target3.AltitudeAboveSeaLevel\nrange3 = (target3.Range)/500\nI:Component_SetFloatLogic_1(33, rangeindex3, 2, range3)\nif altitude3>20\nthen\nI:Component_SetFloatLogic_1(33, heightindex3, 2, 1)\nelse\nI:Component_SetFloatLogic_1(33, heightindex3, 2, 0)\nend\nposition3 = target3.Direction\nrange3 = target3.Range\nazimuth3deg = 90-target3.Azimuth\nazimuth3 = azimuth3deg*Mathf.Deg2Rad  \nxshift3 = (range3*Mathf.Cos(azimuth3))/3000\nyshift3 = (range3*Mathf.Sin(azimuth3))/3000\nI:Component_SetFloatLogic_1(33, index3, 3, -xshift3+1)\nI:Component_SetFloatLogic_1(33, index3, 4, yshift3)\n\ntarget4 = I:GetTargetPositionInfo(0, 3)\naltitude4 = target4.AltitudeAboveSeaLevel\nrange4 = (target4.Range)/500\nI:Component_SetFloatLogic_1(33, rangeindex4, 2, range4)\nif altitude4>20\nthen\nI:Component_SetFloatLogic_1(33, heightindex4, 2, 1)\nelse\nI:Component_SetFloatLogic_1(33, heightindex4, 2, 0)\nend\nposition4 = target4.Direction\nrange4 = target4.Range\nazimuth4deg = 90-target4.Azimuth\nazimuth4 = azimuth4deg*Mathf.Deg2Rad  \nxshift4 = (range4*Mathf.Cos(azimuth4))/3000\nyshift4 = (range4*Mathf.Sin(azimuth4))/3000\nI:Component_SetFloatLogic_1(33, index4, 3, -xshift4)\nI:Component_SetFloatLogic_1(33, index4, 4, yshift4-1)\n\ntarget5 = I:GetTargetPositionInfo(0, 4)\naltitude5 = target5.AltitudeAboveSeaLevel\nrange5 = (target5.Range)/500\nI:Component_SetFloatLogic_1(33, rangeindex5, 2, range5)\nif altitude5>20\nthen\nI:Component_SetFloatLogic_1(33, heightindex5, 2, 1)\nelse\nI:Component_SetFloatLogic_1(33, heightindex5, 2, 0)\nend\nposition5 = target5.Direction\nrange5 = target5.Range\nazimuth5deg = 90-target5.Azimuth\nazimuth5 = azimuth5deg*Mathf.Deg2Rad  \nxshift5 = (range5*Mathf.Cos(azimuth5))/3000\nyshift5 = (range5*Mathf.Sin(azimuth5))/3000\nI:Component_SetFloatLogic_1(33, index5, 3, -xshift5)\nI:Component_SetFloatLogic_1(33, index5, 4, yshift5+1)\n\nend","function Update(I)\n-- put your code here \nend"],"BlockStringDataIds":[478,604,605],"GameVersion":"4.3.4.1","PersistentSubObjectIndex":158,"PersistentBlockIndex":831,"AuthorDetails":{"Valid":false,"ForeignBlocks":0,"CreatorId":"00000000-0000-0000-0000-000000000000","ObjectId":"00000000-0000-0000-0000-000000000000","CreatorReadableName":"","HashV1":"b84624206a654c82d83dd439ab9c5677"},"BlockCount":21890}}